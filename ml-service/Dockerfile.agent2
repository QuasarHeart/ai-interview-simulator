FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

WORKDIR /app
ENV PYTHONPATH=/app

# Runtime libs needed by livekit/sounddevice stack in slim images.
RUN apt-get update && apt-get install -y --no-install-recommends \
    libportaudio2 \
    libasound2 \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

COPY app/requirements.agent2.txt /app/requirements.agent2.txt
RUN pip install --no-cache-dir --no-compile -r /app/requirements.agent2.txt

COPY app /app/app

# LiveKit agent worker (non-HTTP service). Run as a module so the app package resolves correctly.
CMD ["python", "-m", "app.agent", "start"]