FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    libportaudio2 \
    libasound2 \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Use the offline site-packages snapshot generated by export_agent2_site_packages.sh
COPY docker/offline/site-packages-py3.11.tar.gz /tmp/site-packages.tar.gz
RUN tar -C /usr/local/lib/python3.11/site-packages -xzf /tmp/site-packages.tar.gz \
    && rm -f /tmp/site-packages.tar.gz

COPY app /app/app

CMD ["python", "app/agent.py", "start"]