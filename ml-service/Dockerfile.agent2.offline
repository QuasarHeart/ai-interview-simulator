FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app
ENV PYTHONPATH=/app

RUN apt-get update && apt-get install -y --no-install-recommends \
    libportaudio2 \
    libasound2 \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Use a wheelhouse instead of a full site-packages snapshot to keep the image small.
COPY app/requirements.agent2.txt /app/requirements.agent2.txt
COPY docker/offline/wheels /wheels
RUN pip install --no-cache-dir --no-index --find-links=/wheels -r /app/requirements.agent2.txt \
    && rm -rf /wheels

COPY app /app/app

CMD ["python", "-m", "app.agent", "start"]